{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://www.hockeyver.com"
      },
      "autoIncrement": true,
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "bundleIdentifier": "com.hockeyver.app",
        "ascAppId": "6815002964"
      },
      "android": {
        "applicationId": "com.hockeyver.app"
      }
    }
  }
}
